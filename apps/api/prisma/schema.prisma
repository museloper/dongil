generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  CARD
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Cycle {
  MONTHLY
  WEEKLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  currency     String   @default("KRW")
  createdAt    DateTime @default(now())

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  recurring     RecurringRule[]
  refreshTokens RefreshToken[]
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  /// 원 단위 정수
  balance   BigInt      @default(0)
  color     String      @default("#3182F6")
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing    Transaction[] @relation("TxAccount")
  incoming    Transaction[] @relation("TxToAccount")
  recurring   RecurringRule[]

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String
  color     String
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]

  @@index([userId, type])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TxType
  amount      BigInt
  accountId   String
  toAccountId String?
  categoryId  String?
  memo        String?
  occurredAt  DateTime
  recurringId String?
  createdAt   DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account        @relation("TxAccount", fields: [accountId], references: [id])
  toAccount Account?       @relation("TxToAccount", fields: [toAccountId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  recurring RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, categoryId])
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  /// YYYY-MM
  month      String
  /// null 이면 월 전체 예산
  categoryId String?
  amount     BigInt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, month])
}

model RecurringRule {
  id         String   @id @default(cuid())
  userId     String
  type       TxType
  amount     BigInt
  accountId  String
  categoryId String
  memo       String?
  cycle      Cycle
  dayOfMonth Int?
  dayOfWeek  Int?
  nextRunAt  DateTime
  active     Boolean  @default(true)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([active, nextRunAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
