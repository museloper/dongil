generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  CARD
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum Cycle {
  MONTHLY
  WEEKLY
}

enum BookType {
  PERSONAL
  SHARED
}

enum MemberRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  currency     String   @default("KRW")
  createdAt    DateTime @default(now())

  memberships   BookMember[]
  invites       BookInvite[]
  transactions  Transaction[] @relation("TxAuthor")
  notes         BookNote[]
  refreshTokens RefreshToken[]
}

/// 가계부. 모든 돈 데이터는 사용자가 아니라 가계부에 귀속된다.
model Book {
  id        String   @id @default(cuid())
  name      String
  type      BookType
  createdAt DateTime @default(now())

  members      BookMember[]
  invites      BookInvite[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]
  notes        BookNote[]
  tags         Tag[]
}

model BookMember {
  bookId   String
  userId   String
  role     MemberRole
  joinedAt DateTime   @default(now())
  /// 이 멤버가 수입·지출을 입력할 때 먼저 선택되는 계좌. 멤버마다 따로 둔다.
  defaultAccountId String?

  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAccount Account? @relation("MemberDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)

  @@id([bookId, userId])
  @@index([userId])
}

model BookInvite {
  id          String    @id @default(cuid())
  bookId      String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  book      Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model Account {
  id        String      @id @default(cuid())
  bookId    String
  name      String
  type      AccountType
  /// 원 단위 정수
  balance   BigInt      @default(0)
  color     String      @default("#3182F6")
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())

  book      Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  outgoing  Transaction[]   @relation("TxAccount")
  incoming  Transaction[]   @relation("TxToAccount")
  recurring RecurringRule[]
  defaultOf BookMember[]    @relation("MemberDefaultAccount")

  @@index([bookId])
}

model Category {
  id        String       @id @default(cuid())
  bookId    String
  name      String
  type      CategoryType
  icon      String
  color     String
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)
  /// 세부 카테고리면 상위 카테고리. 2단계까지만 두고, 색은 상위를 따른다.
  parentId  String?

  book         Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent       Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]      @relation("CategoryTree")
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]

  @@index([bookId, type])
  @@index([parentId])
}

model Transaction {
  id          String   @id @default(cuid())
  bookId      String
  /// 기록한 사람. 계정이 삭제되면 내역은 남지 않는다(가계부 데이터 정합성 우선).
  createdById String
  type        TxType
  amount      BigInt
  accountId   String
  toAccountId String?
  categoryId  String?
  memo        String?
  occurredAt  DateTime
  recurringId String?
  /// 지출에만 쓴다
  importance  Importance?
  createdAt   DateTime @default(now())

  /// 지출에만 쓴다
  tags      Tag[]
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy User           @relation("TxAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  account   Account        @relation("TxAccount", fields: [accountId], references: [id])
  toAccount Account?       @relation("TxToAccount", fields: [toAccountId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  recurring RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([bookId, occurredAt(sort: Desc)])
  @@index([bookId, categoryId])
}

enum Importance {
  A
  B
  C
}

/// 거래를 저장할 때 이름으로 만들어진다. 쓰는 거래가 없는 태그는 목록에 나오지 않는다.
model Tag {
  id        String   @id @default(cuid())
  bookId    String
  name      String
  createdAt DateTime @default(now())

  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([bookId, name])
}

model Budget {
  id         String    @id @default(cuid())
  bookId     String
  /// YYYY-MM
  month      String
  /// null 이면 월 전체 예산
  categoryId String?
  amount     BigInt

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([bookId, month])
}

model RecurringRule {
  id         String   @id @default(cuid())
  bookId     String
  type       TxType
  amount     BigInt
  accountId  String
  categoryId String
  memo       String?
  cycle      Cycle
  dayOfMonth Int?
  dayOfWeek  Int?
  nextRunAt  DateTime
  active     Boolean  @default(true)

  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([active, nextRunAt])
}

/// 가계부 메모. 멤버끼리 공유하고, 가계부가 삭제되면 함께 지워진다.
model BookNote {
  id        String   @id @default(cuid())
  bookId    String
  /// 작성자. 수정해도 바뀌지 않는다.
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([bookId, updatedAt(sort: Desc)])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
